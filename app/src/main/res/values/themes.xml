<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window shown before Compose draws; the real theme is ui/theme/Theme.kt.
         The background matches the map's land colour so startup has no flash. -->
    <style name="Theme.Fjordvaer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
